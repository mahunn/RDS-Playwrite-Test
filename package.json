{
  "name": "nsu-rds-playwright-automation",
  "version": "1.0.0",
  "description": "Autonomous Playwright MCP and AI Agent Test Automation for NSU RDS",
  "scripts": {
    "test": "playwright test",
    "test:student": "playwright test tests/student/ --workers 1",
    "test:profile": "playwright test tests/student/profile/profile.spec.ts",
    "test:password": "playwright test tests/student/profile/change-password.spec.ts",
    "test:password:headed": "playwright test tests/student/profile/change-password.spec.ts --headed",
    "test:major": "playwright test tests/student/profile/major-declaration.spec.ts",
    "test:major:headed": "playwright test tests/student/profile/major-declaration.spec.ts --headed",
    "test:advising": "playwright test tests/student/advising/course-advising.spec.ts",
    "test:advising:headed": "playwright test tests/student/advising/course-advising.spec.ts --headed",
    "test:slip": "playwright test tests/student/advising/advising-slip.spec.ts",
    "test:slip:headed": "playwright test tests/student/advising/advising-slip.spec.ts --headed",
    "test:preadvising": "playwright test tests/student/advising/pre-advising.spec.ts",
    "test:preadvising:headed": "playwright test tests/student/advising/pre-advising.spec.ts --headed",
    "test:pre-courses": "playwright test tests/student/advising/pre-advised-courses.spec.ts",
    "test:pre-courses:headed": "playwright test tests/student/advising/pre-advised-courses.spec.ts --headed",
    "test:grades": "playwright test tests/student/grades/ --workers 1",
    "test:grade-history": "playwright test tests/student/grades/grade-history.spec.ts",
    "test:grade-history:headed": "playwright test tests/student/grades/grade-history.spec.ts --headed",
    "test:course-marks": "playwright test tests/student/grades/course-wise-marks.spec.ts",
    "test:course-marks:headed": "playwright test tests/student/grades/course-wise-marks.spec.ts --headed",
    "test:attendance": "playwright test tests/student/attendance/attendance.spec.ts",
    "test:attendance:headed": "playwright test tests/student/attendance/attendance.spec.ts --headed",
    "test:faculty-eval": "playwright test tests/student/faculty-evaluation/faculty-evaluation.spec.ts",
    "test:faculty-eval:headed": "playwright test tests/student/faculty-evaluation/faculty-evaluation.spec.ts --headed",
    "test:services": "playwright test tests/student/service/ --workers 1",
    "test:service": "playwright test tests/student/service/ --workers 1",
    "test:status": "playwright test tests/student/service/application-status.spec.ts",
